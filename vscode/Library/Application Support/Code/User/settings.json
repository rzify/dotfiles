      "terminal.ansiMagenta": "#a6a6a6",
      "terminal.ansiCyan": "#c4c4c4",
      "terminal.ansiWhite": "#e6e6e6",
      "terminal.ansiBrightBlack": "#555555",
      "terminal.ansiBrightRed": "#ff7b72",
      "terminal.ansiBrightGreen": "#ffffff",
      "terminal.ansiBrightYellow": "#d9d9d9",
      "terminal.ansiBrightBlue": "#b3b3b3",
      "terminal.ansiBrightMagenta": "#cccccc",
      "terminal.ansiBrightCyan": "#e6e6e6",
      "terminal.ansiBrightWhite": "#ffffff"
