      "editorGutter.deletedBackground": "#e5534b",
      "diffEditor.insertedTextBackground": "#ffffff14",
      "diffEditor.removedTextBackground": "#e5534b1f",
      "sideBar.background": "#000000",
      "sideBar.foreground": "#b3b3b3",
      "sideBar.border": "#1a1a1a",
      "sideBarSectionHeader.background": "#000000",
      "sideBarTitle.foreground": "#888888",
      "activityBar.background": "#000000",
      "activityBar.foreground": "#ffffff",
      "activityBar.inactiveForeground": "#555555",
