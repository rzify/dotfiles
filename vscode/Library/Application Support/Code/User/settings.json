  },
  "editor.tokenColorCustomizations": {
    "[Vesper]": {
      "comments": "#555555",
      "strings": "#a6a6a6",
      "keywords": "#ffffff",
      "numbers": "#c4c4c4",
      "functions": "#e6e6e6",
      "types": "#d9d9d9",
      "variables": "#e6e6e6"
    }
  },
  "workbench.colorTheme": "Vesper",
  "claudeCode.preferredLocation": "sidebar",
  "terminal.integrated.initialHint": false
}
