      "menu.border": "#222222",
      "notifications.background": "#0f0f0f",
      "notifications.border": "#222222",
      "peekView.border": "#555555",
      "peekViewEditor.background": "#0a0a0a",
      "peekViewResult.background": "#0f0f0f",
      "gitDecoration.modifiedResourceForeground": "#b3b3b3",
      "gitDecoration.untrackedResourceForeground": "#ffffff",
      "gitDecoration.addedResourceForeground": "#ffffff",
      "gitDecoration.deletedResourceForeground": "#e5534b",
      "gitDecoration.ignoredResourceForeground": "#3d3d3d",
      "gitDecoration.conflictingResourceForeground": "#e5534b",
      "terminal.ansiBlack": "#1a1a1a",
      "terminal.ansiRed": "#e5534b",
      "terminal.ansiGreen": "#d9d9d9",
      "terminal.ansiYellow": "#b3b3b3",
