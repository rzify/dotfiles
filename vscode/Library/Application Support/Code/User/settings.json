{
  // ── Workbench ──────────────────────────────────────────────────────────────
  "workbench.sideBar.location": "right",
  "workbench.preferredDarkColorTheme": "Vesper",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "Default",
  "workbench.tree.indent": 10,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.expandMode": "singleClick",
  "workbench.list.smoothScrolling": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 8,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.startupEditor": "none",
  "workbench.view.alwaysShowHeaderActions": false,
  "workbench.layoutControl.enabled": false,
  "workbench.statusBar.visible": true,
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",

  // ── Fonte ──────────────────────────────────────────────────────────────────
  "editor.fontFamily": "'JetBrains Mono', 'Geist Mono', 'SF Mono', Menlo, monospace",
  "editor.fontSize": 13,
  "editor.lineHeight": 1.75,
  "editor.letterSpacing": 0.3,
  "editor.fontLigatures": true,
  "editor.fontWeight": "400",
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Geist Mono', monospace",
  "terminal.integrated.fontSize": 12.5,
  "terminal.integrated.lineHeight": 1.3,

  // ── Editor ─────────────────────────────────────────────────────────────────
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "boundary",
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 4,
  "editor.linkedEditing": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": true,
  "editor.wordWrap": "off",
  "editor.suggestSelection": "first",
  "editor.suggest.insertMode": "replace",
  "editor.suggest.localityBonus": true,
  "editor.inlineSuggest.enabled": true,
  "editor.padding.top": 12,
  "editor.padding.bottom": 12,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.occurrencesHighlight": "multiFile",

  // ── Formatação e save ──────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",

  // ── Linguagens ─────────────────────────────────────────────────────────────
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },

  // ── TypeScript ─────────────────────────────────────────────────────────────
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.useAliasesForRenames": false,
  "typescript.suggest.autoImports": true,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "always",

  // ── Tailwind ───────────────────────────────────────────────────────────────
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "class:list"],
  "editor.quickSuggestions": { "strings": "on" },

  // ── ESLint ─────────────────────────────────────────────────────────────────
  "eslint.run": "onSave",
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.problems.shortenToSingleLine": true,

  // ── Error Lens ─────────────────────────────────────────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.fontStyleItalic": true,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.delay": 300,

  // ── Git & GitLens ──────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "git.decorations.enabled": true,
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": false,
  "gitlens.blame.heatmap.enabled": false,
  "scm.diffDecorationsGutterWidth": 2,

  // ── Terminal ───────────────────────────────────────────────────────────────
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.tabs.enabled": true,

  // ── Explorer ───────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": true,
  "explorer.openEditors.visible": 0,
  "explorer.fileNesting.enabled": true,
  "outline.icons": false,
  "outline.showVariables": false,
  "outline.problems.badges": false,
  "outline.problems.colors": false,
  "problems.decorations.enabled": false,
  "scm.countBadge": "off",
  "scm.providerCountBadge": "hidden",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.d.ts",
    "*.tsx": "${capture}.test.tsx, ${capture}.stories.tsx",
    "next.config.*": "next-env.d.ts, tsconfig*.json, .eslintrc*, .prettierrc*, postcss.config.*",
    "package.json": "pnpm-lock.yaml, package-lock.json, yarn.lock, .npmrc, .nvmrc"
  },

  // ── Misc ───────────────────────────────────────────────────────────────────
  "breadcrumbs.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "NOTE", "BUG"],
  "cSpell.language": "en,pt,pt_PT",
  "npm.packageManager": "pnpm",
  "telemetry.telemetryLevel": "off",
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true,
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.git/**": true
  },
  "console-ninja.featureSet": "Community",
  "workbench.colorCustomizations": {
    "[Vesper]": {
      "foreground": "#ffe8c7",
      "focusBorder": "#ff6f91",
      "editor.background": "#2a1652",
      "editor.foreground": "#ffe8c7",
      "editorCursor.foreground": "#ffc799",
      "editor.selectionBackground": "#552f8c",
      "editor.lineHighlightBackground": "#3a2068",
      "editorLineNumber.foreground": "#7a4a8e",
      "editorLineNumber.activeForeground": "#ffc799",
      "editorGroup.border": "#552f8c",
      "editorWidget.background": "#3a2068",
      "sideBar.background": "#1e0f3d",
      "sideBar.border": "#552f8c",
      "sideBarSectionHeader.background": "#1e0f3d",
      "activityBar.background": "#1e0f3d",
      "activityBar.foreground": "#ffc799",
      "activityBar.inactiveForeground": "#7a4a8e",
      "activityBarBadge.background": "#ff6f91",
      "panel.background": "#2a1652",
      "panel.border": "#552f8c",
      "terminal.background": "#2a1652",
      "titleBar.activeBackground": "#1e0f3d",
      "titleBar.inactiveBackground": "#1e0f3d",
      "editorGroupHeader.tabsBackground": "#1e0f3d",
      "tab.activeBackground": "#2a1652",
      "tab.activeForeground": "#ffc799",
      "tab.activeBorderTop": "#ff6f91",
      "tab.inactiveBackground": "#1e0f3d",
      "tab.inactiveForeground": "#b07fc0",
      "list.activeSelectionBackground": "#552f8c",
      "list.hoverBackground": "#3a2068",
      "list.highlightForeground": "#ffc799",
      "input.background": "#3a2068",
      "button.background": "#ff6f91",
      "button.foreground": "#2a1652",
      "badge.background": "#ff6f91",
      "badge.foreground": "#2a1652",
      "statusBar.background": "#1e0f3d",
      "statusBar.foreground": "#b07fc0",
      "statusBarItem.remoteBackground": "#ff6f91",
      "statusBarItem.remoteForeground": "#2a1652",
      "gitDecoration.modifiedResourceForeground": "#ff8a5c",
      "gitDecoration.untrackedResourceForeground": "#ffe0a3",
      "gitDecoration.addedResourceForeground": "#ffe0a3",
      "gitDecoration.deletedResourceForeground": "#f0645f",
      "terminal.ansiBlack": "#3a2068",
      "terminal.ansiRed": "#f0645f",
      "terminal.ansiGreen": "#ffe0a3",
      "terminal.ansiYellow": "#ffc799",
      "terminal.ansiBlue": "#c6dcff",
      "terminal.ansiMagenta": "#ff6f91",
      "terminal.ansiCyan": "#ffcad8",
      "terminal.ansiWhite": "#ffe8c7",
      "terminal.ansiBrightBlack": "#7a4a8e",
      "terminal.ansiBrightRed": "#ff8a7a",
      "terminal.ansiBrightGreen": "#fff1c4",
      "terminal.ansiBrightYellow": "#ffdcbf",
      "terminal.ansiBrightBlue": "#e0ecff",
      "terminal.ansiBrightMagenta": "#ff9db5",
      "terminal.ansiBrightCyan": "#ffe1ea",
      "terminal.ansiBrightWhite": "#ffffff"
    }
  },
  "editor.tokenColorCustomizations": {
    "[Vesper]": {
      "comments": "#b07fc0",
      "strings": "#ffe0a3",
      "keywords": "#ff6f91",
      "numbers": "#c6dcff",
      "functions": "#d79be6",
      "types": "#ffc799",
      "variables": "#ffe8c7"
    }
  },
  "workbench.colorTheme": "Vesper",
  "claudeCode.preferredLocation": "sidebar",
  "terminal.integrated.initialHint": false
}
