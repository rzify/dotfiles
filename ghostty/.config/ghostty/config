background = #000000
foreground = #e6e6e6
cursor-color = #ffffff
cursor-text = #000000
selection-background = #333333
selection-foreground = #ffffff
palette = 0=#1a1a1a
palette = 1=#e5534b
palette = 2=#d9d9d9
palette = 3=#b3b3b3
palette = 4=#8c8c8c
palette = 5=#a6a6a6
palette = 6=#c4c4c4
