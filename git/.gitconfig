[user]
	name = Fábio Fernandes
	# No email here on purpose. Identity is set per-context by the
	# includeIf rules below. useConfigOnly makes git REFUSE to commit
	# with a guessed identity — you must be inside a known context dir.
	useConfigOnly = true

# ── Identity isolation by directory ───────────────────────────────
# Whichever tree the repo lives in decides email, signing key, and
# the SSH key used to push. Impossible to cross identities.
[includeIf "gitdir:~/Development/rzlabs/"]
	path = ~/.gitconfig-personal

[includeIf "gitdir:~/Documents/"]
	path = ~/.gitconfig-personal

[includeIf "gitdir:~/Development/hypnotic/"]
	path = ~/.gitconfig-work

[includeIf "gitdir:~/Development/obraxray/"]
	path = ~/.gitconfig-obra

# ── Commit signing (SSH) ──────────────────────────────────────────
# Every commit/tag is signed. The signing key itself is set per
# context (so personal commits sign with the personal key, etc.).
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# ── Sensible defaults ─────────────────────────────────────────────
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[credential]
	helper = osxkeychain
[core]
	excludesfile = ~/.config/git/ignore
[diff]
	colorMoved = default
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[includeIf "gitdir:~/Development/keybind-studios/"]
	path = ~/.gitconfig-personal
