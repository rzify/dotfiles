# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# ~/.ssh/config — managed in dotfiles (ssh/.ssh/config)
# Key naming: one key per identity. personal | work | obra | ha_homeassistant
# Git identity (email/signing) is set by directory via ~/.gitconfig includeIf.
# These Host aliases pin the right KEY and make clone URLs self-documenting.

# ── Global defaults ───────────────────────────────────────────────
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

# ── GitHub ────────────────────────────────────────────────────────
# Personal account: rzify. Default for plain git@github.com.
Host github.com github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/personal

# ObraXRAY account/org: obraxray. Clone: git@github-obra:obraxray/repo.git
Host github-obra
  HostName github.com
  User git
  IdentityFile ~/.ssh/obra

# Work key on GitHub (currently also registered on rzify). Rarely needed —
# Hypnotic work lives on GitLab. Kept for completeness.
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/work

# ── GitLab (account: fabiomiguelmfernandes) ───────────────────────
# Default + work alias use the work key.
Host gitlab.com gitlab-work
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/work

# Personal repos hosted on the same GitLab account push with personal key.
Host gitlab-personal
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/personal

# ── Servers ───────────────────────────────────────────────────────
Host obraxray-vps
  HostName 178.104.103.183
  User root
  IdentityFile ~/.ssh/obra

Host homeassistant
  HostName 192.168.1.138
  Port 22222
  User root
  IdentityFile ~/.ssh/ha_homeassistant
