# macOS ssh-agent defaults (store passphrase in Keychain on first use)
Host *
  AddKeysToAgent yes
  UseKeychain yes

# Personal GitHub (default for git@github.com:...)
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/personal
  IdentitiesOnly yes

# Work GitHub alias — clone with git@github-work:org/repo.git
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/work
  IdentitiesOnly yes

# Work GitLab
Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/work
  IdentitiesOnly yes
